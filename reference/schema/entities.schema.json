{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Civ VI GameCore reference: entity records",
  "$defs": {
    "status": {
      "enum": [
        "verified",
        "inferred",
        "unknown"
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "dll-registration",
            "static-analysis",
            "dwarf",
            "game-script",
            "runtime",
            "community-reference",
            "exe-registration",
            "exe-string",
            "exe-disassembly",
            "user-file"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "build_ref": {
      "type": "object",
      "properties": {
        "rva": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^0x[0-9a-f]+$"
        },
        "map": {
          "type": "string"
        }
      }
    },
    "builds": {
      "type": "object",
      "properties": {
        "symbol": {
          "$ref": "#/$defs/build_ref"
        },
        "current": {
          "$ref": "#/$defs/build_ref"
        }
      }
    },
    "note": {
      "type": "object",
      "required": [
        "text",
        "status",
        "evidence"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "curated": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "lua_usage": {
          "type": "string"
        },
        "signature_fix": {
          "type": "object",
          "required": [
            "params"
          ],
          "properties": {
            "params": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type",
                  "optional"
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "lua_method": {
      "type": "object",
      "required": [
        "id",
        "object",
        "method",
        "registered_on",
        "builds",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^lua:[A-Za-z0-9_]+\\.[A-Za-z0-9_]+$"
        },
        "object": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "registered_on": {
          "type": "array",
          "items": {
            "enum": [
              "ui-cache",
              "gameplay"
            ]
          }
        },
        "in_community_reference": {
          "type": "boolean"
        },
        "signatures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "params",
              "returns",
              "confidence"
            ],
            "properties": {
              "params": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "type",
                    "optional"
                  ]
                }
              },
              "returns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "confidence": {
                "enum": [
                  "high",
                  "partial",
                  "low"
                ]
              }
            }
          }
        },
        "builds": {
          "$ref": "#/$defs/builds"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "operation": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "lua",
        "hash",
        "handlers",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^op:[a-z-]+\\.[A-Z0-9_]+$"
        },
        "kind": {
          "enum": [
            "player-operation",
            "unit-operation",
            "unit-command",
            "city-operation",
            "city-command"
          ]
        },
        "hash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{8}$"
        },
        "handlers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "type",
              "builds"
            ],
            "properties": {
              "builds": {
                "$ref": "#/$defs/builds"
              }
            }
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "id",
        "cpp",
        "size",
        "members",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^layout:"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "bases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "offset"
            ]
          }
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "offset",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "offset": {
                "type": "integer",
                "minimum": 0
              },
              "type": {
                "type": "string"
              },
              "windows": {
                "type": "object",
                "required": [
                  "offset",
                  "relation",
                  "status",
                  "evidence"
                ],
                "properties": {
                  "offset": {
                    "type": "string",
                    "pattern": "^0x[0-9a-f]+$"
                  },
                  "relation": {
                    "enum": [
                      "same",
                      "minus8",
                      "differs"
                    ]
                  },
                  "status": {
                    "$ref": "#/$defs/status"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/evidence"
                    }
                  }
                }
              }
            }
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "global": {
      "type": "object",
      "required": [
        "id",
        "cpp",
        "type",
        "section",
        "builds",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^global:"
        },
        "builds": {
          "$ref": "#/$defs/builds"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "enum": {
      "type": "object",
      "required": [
        "id",
        "cpp_type",
        "members",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^enum:"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "hash"
            ]
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "ce_method": {
      "type": "object",
      "required": [
        "id",
        "object",
        "method",
        "static",
        "signatures",
        "wiki",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ce:"
        },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "params",
              "returns"
            ]
          }
        },
        "builds": {
          "$ref": "#/$defs/builds"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "native": {
      "type": "object",
      "required": [
        "id",
        "class",
        "function",
        "builds",
        "lua_exposure",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^native:"
        },
        "builds": {
          "$ref": "#/$defs/builds"
        },
        "lua_exposure": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "none",
                "indirect",
                "ce",
                "devce"
              ]
            }
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "param": {
      "type": "object",
      "required": [
        "id",
        "table",
        "name",
        "summary",
        "value",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^param:"
        },
        "value": {
          "type": "object",
          "required": [
            "kind"
          ]
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "devce_method": {
      "type": "object",
      "required": [
        "id",
        "object",
        "method",
        "static",
        "signatures",
        "status",
        "evidence",
        "tests"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^devce:"
        },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "params",
              "returns"
            ]
          }
        },
        "builds": {
          "$ref": "#/$defs/builds"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "exe_option": {
      "type": "object",
      "required": [
        "id",
        "section",
        "key",
        "value_type",
        "default",
        "description",
        "cli_override",
        "registered_at",
        "availability",
        "status",
        "evidence",
        "file",
        "description_source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^exeopt:"
        },
        "section": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "value_type": {
          "enum": [
            "integer",
            "string"
          ]
        },
        "default": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "cli_override": {
          "type": "boolean"
        },
        "registered_at": {
          "type": "string",
          "pattern": "^0x[0-9a-f]+$"
        },
        "registered_in": {
          "type": "string"
        },
        "read_sites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "availability": {
          "const": "exe"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "description_source": {
          "enum": [
            "exe",
            "options-file",
            null
          ]
        }
      }
    },
    "exe_switch": {
      "type": "object",
      "required": [
        "id",
        "switch",
        "kind",
        "function",
        "effect",
        "availability",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^exeswitch:"
        },
        "switch": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "fixed",
            "generic"
          ]
        },
        "function": {
          "type": "string"
        },
        "rva": {
          "type": [
            "string",
            "null"
          ]
        },
        "effect": {
          "type": "string"
        },
        "availability": {
          "const": "exe"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "exe_command": {
      "type": "object",
      "required": [
        "id",
        "command",
        "description",
        "handler",
        "handler_rva",
        "availability",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^execmd:"
        },
        "command": {
          "type": "string"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "handler": {
          "type": "string"
        },
        "handler_rva": {
          "type": "string",
          "pattern": "^0x[0-9a-f]+$"
        },
        "availability": {
          "const": "exe"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "exe_lua_method": {
      "type": "object",
      "required": [
        "id",
        "object",
        "method",
        "object_kind",
        "call_style",
        "wrapper_rva",
        "params",
        "availability",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^exelua:"
        },
        "object": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "object_kind": {
          "enum": [
            "static table",
            "object type",
            "control type"
          ]
        },
        "call_style": {
          "enum": [
            "static",
            "object"
          ]
        },
        "wrapper_rva": {
          "type": "string",
          "pattern": "^0x[0-9a-f]+$"
        },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "lua_type",
              "optional"
            ],
            "properties": {
              "index": {
                "type": "integer"
              },
              "lua_type": {
                "type": "string"
              },
              "optional": {
                "type": "boolean"
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "returns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "param_certainty": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "availability": {
          "const": "exe"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "exe_lua_table": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "style",
        "basis",
        "methods",
        "status",
        "family"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^exetable:"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "style": {
          "enum": [
            "static",
            "object"
          ]
        },
        "basis": {
          "type": "string"
        },
        "methods": {
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "family": {
          "enum": [
            "native",
            "forgeui",
            "events"
          ]
        }
      }
    },
    "exe_event": {
      "type": "object",
      "required": [
        "id",
        "bus",
        "event_id",
        "name",
        "subscribers",
        "availability",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^exeevt:"
        },
        "bus": {
          "enum": [
            "GameCore",
            "LocalMachine",
            "Serial",
            "UIEvent",
            "Sequencer",
            "MovieEvent"
          ]
        },
        "event_id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "lua_events": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subscribers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "system",
              "linux_va"
            ],
            "properties": {
              "system": {
                "type": "string"
              },
              "linux_va": {
                "type": "string"
              }
            }
          }
        },
        "availability": {
          "const": "exe"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "exe_bus": {
      "type": "object",
      "required": [
        "id",
        "name",
        "description",
        "events"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^exebus:"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "events": {
          "type": "integer"
        }
      }
    },
    "exe_file": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "text",
        "encoding",
        "functions",
        "availability",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^exefile:"
        },
        "kind": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "encoding": {
          "type": "string"
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rva"
            ],
            "properties": {
              "rva": {
                "type": "string"
              }
            }
          }
        },
        "availability": {
          "const": "exe"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "exe_sql": {
      "type": "object",
      "required": [
        "id",
        "sql",
        "operation",
        "tables",
        "database",
        "availability",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^exesql:"
        },
        "sql": {
          "type": "string"
        },
        "operation": {
          "type": "string"
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rva"
            ],
            "properties": {
              "rva": {
                "type": "string"
              }
            }
          }
        },
        "database": {
          "type": "string"
        },
        "availability": {
          "const": "exe"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "exe_text_key": {
      "type": "object",
      "required": [
        "id",
        "key",
        "availability",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^exeloc:"
        },
        "key": {
          "type": "string"
        },
        "functions": {
